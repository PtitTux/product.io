{
  "compilerOptions": {
    "target": "ES2020",
    "baseUrl": "app",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "outDir": "./dist",
    "preserveConstEnums": true,
    "removeComments": true,
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": [
    "app/**/*.ts",
    "tests/**/*.ts",
    "drizzle.config.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*/__mocks__/*.ts",
    "app/test/*.ts"
  ]
}
